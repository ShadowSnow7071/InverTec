FLASK_APP=backend.wsgi
APP_CONFIG=development

SECRET_KEY=cambiar-en-desarrollo
JWT_SECRET_KEY=cambiar-jwt-en-desarrollo-min-32-bytes

DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/invertec

# Opcional: clave de Alpha Vantage para consultar precios reales.
MARKET_DATA_API_KEY=apikey-alpha-vantage

# Opcional: segundos que se guarda en caché cada cotización (precio real o
# fallback simulado) antes de volver a consultar Alpha Vantage. Por defecto
# 43200 (12 horas) si no se define esta variable.
MARKET_DATA_CACHE_SEGUNDOS=tiempo-en-segundos-para-cachear-precios-reales

# Recuperación de contraseña mediante Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@tudominio.com
APP_BASE_URL=http://127.0.0.1:5000
